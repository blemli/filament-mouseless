{
    "name": "blemli/filament-mouseless",
    "description": "use filament without a mouse",
    "keywords": [
        "blemli",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-mouseless"
    ],
    "homepage": "https://github.com/blemli/filament-mouseless",
    "support": {
        "issues": "https://github.com/blemli/filament-mouseless/issues",
        "source": "https://github.com/blemli/filament-mouseless"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Problemli GmbH",
            "email": "apps@problem.li",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Blemli\\FilamentMouseless\\": "src/",
            "Blemli\\FilamentMouseless\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blemli\\FilamentMouseless\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blemli\\FilamentMouseless\\FilamentMouselessServiceProvider"
            ],
            "aliases": {
                "FilamentMouseless": "Blemli\\FilamentMouseless\\Facades\\FilamentMouseless"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}